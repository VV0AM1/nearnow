# EXPO_PUBLIC_* values are embedded in the app bundle — never put secrets here.
# Android emulator: http://10.0.2.2:3002 · iOS simulator: http://localhost:3002
# Physical device: http://<your-computer-LAN-IP>:3002 · Production: https://nearnow.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3002
# Optional: EAS project id; push notifications stay disabled without it.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional links shown in Profile > Privacy & support (hidden when empty).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
