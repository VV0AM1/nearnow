datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Category {
  GENERAL
  CRIME
  SAFETY
  LOST_FOUND
  EVENT
  RECOMMENDATION
  DANGER
}

// Legacy: no longer written or displayed (raw report counts cannot establish safety).
enum SafetyLevel {
  SAFE
  MODERATE
  CAUTION
  DANGER
  CRITICAL
}

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  name       String?
  avatar     String?
  bio        String?
  role       Role    @default(USER)
  reputation Int     @default(0)

  auth                 Auth?
  posts                Post[]
  comments             Comment[]
  neighborhoods        Neighborhood[]
  votes                PostVote[]
  notifications        Notification[]
  notificationSettings NotificationSettings?
  savedPosts           SavedPost[]
  confirmations        PostConfirmation[]
  deviceTokens         DeviceToken[]
  moderationActions    ModerationAction[]
  contactRequestsSent  ContactRequest[]   @relation("ContactRequester")
  contactRequestsRecv  ContactRequest[]   @relation("ContactRecipient")
  blocking             UserBlock[]        @relation("Blocker")
  blockedBy            UserBlock[]        @relation("Blocked")

  isBlocked Boolean   @default(false)
  // Set when the account was deleted/anonymised at the user's request.
  deletedAt DateTime?
  reports   Report[]  @relation("ReportedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isBlocked]) // For filtering blocked users (Auth/Admin)
}

model Auth {
  id              String  @id @default(uuid())
  // bcrypt hash. Rows created before 2026-10 may still hold legacy plaintext; they are
  // re-hashed on the next successful login (see AuthService.verifyPassword).
  passwordHash    String?
  googleId        String? @unique
  facebookId      String? @unique
  twoFactorSecret String?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  // SHA-256 of the one-time code, never the code itself.
  emailOtp    String?
  otpExpires  DateTime?
  otpAttempts Int       @default(0)
}

enum NotificationType {
  INFO
  ALERT
  WELCOME
  POST_NEARBY
  COMMENT
  POST_UPDATE
  MATCH_SUGGESTION
  CONTACT_REQUEST
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String? // Make optional as not all notifs have titles
  message String
  read    Boolean          @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId String?

  createdAt DateTime @default(now())

  @@index([userId]) // For fetching user notifications
  @@index([read]) // For filtering unread
  @@index([userId, postId, type]) // Deduplication lookups
}

model NotificationSettings {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  emailAlerts Boolean @default(false)
  // Legacy mirror of pushEnabled, kept in sync for older clients.
  pushAlerts  Boolean @default(false)
  pushEnabled Boolean @default(false)
  // Pauses every nearby alert without losing the configuration.
  paused      Boolean @default(false)

  radiusKm   Float      @default(2.0)
  // Explicitly chosen alert area; null means "not set" (no nearby alerts are sent).
  latitude   Float?
  longitude  Float?
  areaLabel  String?
  categories Category[]

  // Minutes after local midnight; push is suppressed between start and end.
  quietHoursStart Int?
  quietHoursEnd   Int?
  timezone        String?

  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
}

model DeviceToken {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  token      String    @unique
  platform   String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model City {
  id        String @id @default(uuid())
  name      String @unique
  country   String
  latitude  Float
  longitude Float

  neighborhoods Neighborhood[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude]) // For geospatial lookups
}

model Neighborhood {
  id   String @id @default(uuid())
  name String

  city   City   @relation(fields: [cityId], references: [id])
  cityId String

  latitude    Float
  longitude   Float
  radiusKm    Float       @default(1.0)
  // Legacy columns (no longer updated): counts of user posts are not a safety measure.
  safetyLevel SafetyLevel @default(SAFE)
  crimeCount  Int         @default(0)
  safetyCount Int         @default(0)
  totalCount  Int         @default(0)

  users User[]
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, cityId])
  @@index([latitude, longitude]) // For finding nearby neighborhoods
  @@index([cityId])
}

enum PostStatus {
  ACTIVE
  RESOLVED
  // Expiry is evaluated at query time from expiresAt; this value exists for API parity.
  EXPIRED
  REMOVED
}

enum VerificationStatus {
  UNVERIFIED
  COMMUNITY_CONFIRMED
  // Only assigned by a configured official-data provider with provenance.
  OFFICIAL_SOURCE
}

enum SourceType {
  COMMUNITY
  OFFICIAL
}

model Post {
  id       String   @id @default(uuid())
  title    String
  content  String?
  imageUrl String?
  category Category @default(GENERAL)

  latitude              Float
  longitude             Float
  // True when the author chose to publish a rounded (~300 m) location.
  isApproximateLocation Boolean @default(false)

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  neighborhoodId String?

  status             PostStatus         @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  sourceType         SourceType         @default(COMMUNITY)
  sourceName         String?
  sourceUrl          String?
  sourceExternalId   String?
  expiresAt          DateTime?
  lastConfirmedAt    DateTime?
  resolvedAt         DateTime?
  resolvedById       String?
  resolutionNote     String?

  comments      Comment[]
  votes         PostVote[]
  notifications Notification[]
  reports       Report[]
  savedBy       SavedPost[]
  confirmations PostConfirmation[]
  lostFound     LostFoundItem?

  likes Int @default(0) // Cache for performance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceName, sourceExternalId])
  @@index([latitude, longitude]) // For geospatial feed queries
  @@index([neighborhoodId]) // For neighborhood feed queries
  @@index([createdAt]) // For feed sorting
  @@index([authorId]) // For profile queries
  @@index([status, expiresAt])
  @@index([category, createdAt])
}

enum ConfirmationState {
  STILL_HAPPENING
  NO_LONGER_PRESENT
}

// "Is this still happening?" answers. Separate from Report, which is for abuse/moderation.
model PostConfirmation {
  id     String            @id @default(uuid())
  state  ConfirmationState
  post   Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId, state])
}

// Audit trail for moderation-sensitive actions (resolve, remove, report review, block).
model ModerationAction {
  id         String   @id @default(uuid())
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

model Comment {
  id      String @id @default(uuid())
  content String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  createdAt DateTime @default(now())

  @@index([postId]) // For fetching post comments
}

model PostVote {
  id   String @id @default(uuid()) // standard uuid
  type String // "UP" (future proof for "DOWN")

  user   User   @relation(fields: [userId], references: [id])
  userId String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model SavedPost {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// Abuse/moderation reports about a post.
model Report {
  id      String       @id @default(uuid())
  reason  String
  details String?
  status  ReportStatus @default(PENDING)

  reporter   User   @relation("ReportedBy", fields: [reporterId], references: [id])
  reporterId String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status]) // For admin dashboard filtering
  @@index([postId, reporterId])
}

enum LostFoundDirection {
  LOST
  FOUND
}

enum LostFoundItemType {
  KEYS
  WALLET_BAG
  ELECTRONICS
  DOCUMENT
  PET
  CLOTHING
  OTHER
}

enum LostFoundStatus {
  OPEN
  RETURNED
  CLOSED
}

model LostFoundItem {
  id           String             @id @default(uuid())
  post         Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String             @unique
  direction    LostFoundDirection
  itemType     LostFoundItemType
  occurredFrom DateTime
  occurredTo   DateTime
  status       LostFoundStatus    @default(OPEN)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([direction, itemType, status])
}

model LostFoundMatchDismissal {
  id              String   @id @default(uuid())
  userId          String
  sourcePostId    String
  candidatePostId String
  createdAt       DateTime @default(now())

  @@unique([userId, sourcePostId, candidatePostId])
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// Privacy-preserving contact: no email/phone is exchanged unless the recipient
// chooses to include it in their reply.
model ContactRequest {
  id              String               @id @default(uuid())
  postId          String
  relatedPostId   String?
  requester       User                 @relation("ContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId     String
  recipient       User                 @relation("ContactRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId     String
  message         String
  status          ContactRequestStatus @default(PENDING)
  responseMessage String?
  createdAt       DateTime             @default(now())
  respondedAt     DateTime?

  @@index([recipientId, status])
  @@index([requesterId])
  @@index([postId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}
