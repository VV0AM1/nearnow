# Copy to .env (untracked). All values here are SERVER-ONLY secrets/config.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/nearnow_db?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5433/nearnow_db?schema=public
NODE_ENV=development
PORT=3002
# Required in production, >= 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed by CORS/socket. Required in production.
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000
# Optional absolute base for links to uploaded files.
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
# Gmail (or EMAIL_SERVICE) app credentials. Required in production for sign-in codes.
EMAIL_USER=
EMAIL_PASS=
EMAIL_SERVICE=gmail
# Local disk storage. Must be a persistent volume in production.
UPLOAD_DIR=./uploads
# Optional providers — disabled unless set.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
GEOCODER_PROVIDER=
GEOCODER_USER_AGENT=
