# Copy to .env (untracked). All values here are SERVER-ONLY secrets/config.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/nearnow_db?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5433/nearnow_db?schema=public
NODE_ENV=development
PORT=3002
# Required in production, >= 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed by CORS/socket. Required in production.
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000
# Optional absolute base for links to uploaded files.
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
# Gmail (or EMAIL_SERVICE) app credentials. Required in production for sign-in codes.
EMAIL_USER=
EMAIL_PASS=
EMAIL_SERVICE=gmail
# Photo storage: "local" (default) or "s3" (Cloudflare R2, AWS S3, any S3-compatible store).
# Local disk must be a persistent volume in production; Render's free plan disk is wiped on redeploy.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Required when STORAGE_PROVIDER=s3. For Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   STORAGE_PUBLIC_URL = the bucket's public URL (r2.dev subdomain or custom domain)
# Local testing: `docker compose up -d s3mock`, then S3_ENDPOINT=http://localhost:9090,
#   S3_BUCKET=nearnow-dev, S3_FORCE_PATH_STYLE=true, STORAGE_PUBLIC_URL=http://localhost:9090/nearnow-dev
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=
# Optional providers — disabled unless set.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
GEOCODER_PROVIDER=
GEOCODER_USER_AGENT=
