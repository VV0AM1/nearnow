# Used by docker-compose.yml / docker-compose.prod.yml. Copy to `.env` (untracked) and fill in.
POSTGRES_USER=nearnow_admin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=nearnow_db
POSTGRES_HOST_PORT=5433

# docker-compose.prod.yml only
JWT_SECRET=generate-a-long-random-value
CORS_ORIGINS=https://your-web-domain.example
PUBLIC_BASE_URL=https://your-api-domain.example
EMAIL_USER=
EMAIL_PASS=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_URL=https://your-api-domain.example
NEXT_PUBLIC_SOCKET_URL=https://your-api-domain.example
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
